{
  "expo": {
    "name": "Orbe",
    "slug": "orbe",
    "version": "1.0.1",
    "orientation": "portrait",
    "scheme": "habittracker",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.coldcode.orbe"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "package": "com.coldcode.orbe",
      "versionCode": 3,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single"
    },
    "icon": "assets/images/icon.png",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#FAFAFB",
          "dark": {
            "backgroundColor": "#0F172A"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "DEMO_MODE": false,
      "eas": {
        "projectId": "85a8201c-54af-4736-9b35-390e4052554a"
      }
    }
  }
}
